        <asp:ContentPlaceHolder ID="jqury" runat="server">
        </asp:ContentPlaceHolder>
        <script type="text/javascript">
            document.addEventListener('contextmenu', function (e) {
                e.preventDefault();
            }, false);
        </script>
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WBD2B9DK"
                height="0" width="0" style="display: none; visibility: hidden"></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->

        <script>
            var chatStep = "";
            var offerData = {};

            function openChat() {
                $('#chatWidget').fadeIn();
                $('#chatIcon').hide();

                if ($('#chatBody').html().trim() === '') {
                    showMainMenu();
                }
            }

            function closeChat() {
                $('#chatWidget').fadeOut();
                $('#chatIcon').show();
            }

            function addBotMessage(msg) {
                $('#chatBody').append("<div class='botMsg'>" + msg + "</div>");
                $('#chatBody').scrollTop($('#chatBody')[0].scrollHeight);
            }

            function addUserMessage(msg) {
                $('#chatBody').append("<div class='userMsg'>" + msg + "</div>");
                $('#chatBody').scrollTop($('#chatBody')[0].scrollHeight);
            }

            /* ---------------- MAIN MENU ---------------- */
            function showMainMenu() {
                chatStep = "";
                offerData = {};

                addBotMessage(
                    "<div class='chat-option' onclick='startViewOffer()'>📄 View Offer Letter</div>" +
                    "<div class='chat-option' onclick='startCOE()'>📘 Download COE</div>" +
                    "<div class='chat-option' onclick='startOfficerChat()'>💬 Chat with Officer</div>"
                );
            }

            /* ---------------- START OFFER LETTER FLOW ---------------- */
            function startViewOffer() {
                chatStep = "student_id";
                offerData = {};
                addBotMessage("🔐 Please enter your <b>Student ID</b>:");
            }

            function startOfficerChat() {
                chatStep = "";
                addBotMessage("🔴 Connecting you to a support officer...");
            }

            /* ---------------- HANDLE USER INPUT ---------------- */
            function sendChat() {
                var msg = $('#chatInput').val();
                if (!msg) return;

                addUserMessage(msg);
                $('#chatInput').val('');

                switch (chatStep) {

                    case "student_id":
                        offerData.student_id = msg;
                        chatStep = "passport";
                        addBotMessage("Please enter your <b>Passport Number</b>:");
                        break;

                    case "passport":
                        offerData.passport = msg;
                        chatStep = "dob";
                        addBotMessage("Please enter your <b>Date of Birth</b> (dd/MM/yyyy):");
                        break;

                    case "dob":
                        // simple DOB format validation
                        var dobRegex = /^(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[012])\/\d{4}$/;
                        if (!dobRegex.test(msg)) {
                            addBotMessage("❌ Invalid date format. Please use <b>dd/MM/yyyy</b>.");
                            return;
                        }

                        offerData.dob = msg;
                        chatStep = "";
                        validateOfferLetter();
                        break;

                    default:
                        addBotMessage("❌ Please select an option from the menu.");
                        break;
                }
            }

            /* ---------------- BACKEND VALIDATION ---------------- */
            function validateOfferLetter() {
                addBotMessage("🔎 Verifying your details, please wait...");

                $.ajax({
                    type: "POST",
                    url: "ChatService.aspx/ValidateOfferLetter",
                    data: JSON.stringify({ data: offerData }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (res) {
                        if (res.d && res.d.success) {
                            addBotMessage(
                                "✅ Verification successful.<br><br>" +
                                "<a href='" + res.d.link + "' target='_blank' class='chat-link'>📄 View Your Offer Letter</a>"
                            );
                        } else {
                            addBotMessage("❌ Verification failed. Please check your details or contact support.");
                        }
                    },
                    error: function () {
                        addBotMessage("⚠️ Server error. Please try again later.");
                    }
                });
            }
        </script>
        <script type="text/javascript">
            // 1. Block Right-Click
            document.addEventListener('contextmenu', function (e) {
                e.preventDefault();
            }, false);

            // 2. Block Keyboard Shortcuts
            document.addEventListener('keydown', function (e) {
                // Block Ctrl+U (View Source)
                if (e.ctrlKey && (e.keyCode === 85 || e.key === 'u')) {
                    e.preventDefault();
                    return false;
                }

                // Block Ctrl+Shift+I, Ctrl+Shift+J, or F12 (Developer Tools)
                if (
                    e.keyCode === 123 || // F12
                    (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.key === 'I')) || // Ctrl+Shift+I
                    (e.ctrlKey && e.shiftKey && (e.keyCode === 74 || e.key === 'J'))    // Ctrl+Shift+J
                ) {
                    e.preventDefault();
                    return false;
                }

                // Optional: Block Ctrl+C (Copy)
                if (e.ctrlKey && (e.keyCode === 83 || e.key === 's')) {
                    e.preventDefault();
                    return false;
                }
            });
        </script>
    </form>
</body>
</html>
