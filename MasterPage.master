    <style>
        /* CHAT ICON */
        #chatIcon {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 55px;
            height: 55px;
            background: #c62828;
            color: #fff;
            font-size: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            z-index: 99999;
        }

        /* CHAT WINDOW */
        #chatWidget {
            position: fixed;
            bottom: 85px;
            right: 20px;
            width: 340px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.25);
            font-family: Segoe UI, Arial, sans-serif;
            overflow: hidden;
            z-index: 99999;
        }

        #chatHeader {
            background: #c62828;
            color: #fff;
            padding: 12px;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #chatBody {
            height: 280px;
            padding: 10px;
            overflow-y: auto;
            background: #f6f7f9;
        }

        .botMsg, .userMsg {
            margin-bottom: 10px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            max-width: 85%;
        }

        .botMsg {
            background: #fff;
            border: 1px solid #ddd;
        }

        .userMsg {
            background: #c62828;
            color: #fff;
            margin-left: auto;
            text-align: right;
        }

        #chatFooter {
            display: flex;
            border-top: 1px solid #ddd;
        }

        #chatInput {
            flex: 1;
            border: none;
            padding: 10px;
            outline: none;
        }

        #chatFooter button {
            background: #c62828;
            color: #fff;
            border: none;
            padding: 0 15px;
            cursor: pointer;
        }

        /* Clickable chat options (NO button, NO postback) */
        .chat-option {
            background: #ffffff;
            border: 1px solid #ddd;
            padding: 10px 12px;
            margin-bottom: 8px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            transition: background 0.2s, border 0.2s;
        }

            .chat-option:hover {
                background: #fbe9e7;
                border-color: #c62828;
            }

        /* Offer letter link style */
        .chat-link {
            display: inline-block;
            padding: 8px 12px;
            background: #c62828;
            color: #fff !important;
            border-radius: 4px;
            text-decoration: none;
            font-size: 13px;
        }

            .chat-link:hover {
                background: #b71c1c;
            }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
